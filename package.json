{
  "name": "quad-box",
  "private": true,
  "version": "1.2.0",
  "description": "Quad Box and DocCT cognitive training with unified statistics",
  "author": "The Quad Box Project Contributors",
  "desktopName": "org.quadbox.cognitive-suite",
  "main": "desktop/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "validate": "npm run lint && npm run check && npm test && npm run build",
    "desktop:run": "npm run build && electron .",
    "desktop:dir": "npm run build && electron-builder --dir --publish never",
    "desktop:package": "npm run build && electron-builder --publish never",
    "view-shapes": "vite --open /view-shape-pool.html"
  },
  "build": {
    "appId": "org.quadbox.cognitive-suite",
    "productName": "Quad Box Cognitive Suite",
    "asar": true,
    "npmRebuild": false,
    "compression": "maximum",
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build-resources/icon.ico",
      "artifactName": "Quad-Box-Cognitive-Suite-${version}-Windows-${arch}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build-resources/icon.png",
      "category": "public.app-category.education",
      "artifactName": "Quad-Box-Cognitive-Suite-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build-resources/icon.png",
      "category": "Education",
      "syncDesktopName": true,
      "artifactName": "Quad-Box-Cognitive-Suite-${version}-Linux-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "@lucide/svelte": "^0.511.0",
    "@mariohamann/activity-graph": "^1.0.5",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.1.7",
    "chart.js": "^4.4.9",
    "chartjs-adapter-date-fns": "^3.0.0",
    "d3": "^7.9.0",
    "d3-geo": "^3.1.1",
    "d3-random": "^3.0.1",
    "d3-shape": "^3.2.0",
    "daisyui": "^5.0.35",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.27.0",
    "eslint-plugin-svelte": "^3.6.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "globals": "^16.1.0",
    "howler": "^2.2.4",
    "jsdom": "^27.0.0",
    "svelte": "^5.28.1",
    "svelte-check": "^4.7.6",
    "svgpath": "^2.6.0",
    "tailwindcss": "^4.1.7",
    "theme-change": "^2.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
